DATABASE_URL=postgres://spica:spica@localhost:5432/spica
TEST_DATABASE_URL=postgres://spica:spica@localhost:5432/spica_test
EVAL_DATABASE_URL=postgres://spica:spica@localhost:5432/spica_eval
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Inspector: defaults to enabled outside production. Comma-separated admin USER IDS (not emails:
# sign-up emails are unverified). Find yours after signing up:
#   docker exec spica-db-1 psql -U spica -d spica -tAc "select id from \"user\" where email='you@example.com'"
INSPECTOR_ENABLED=true
INSPECTOR_ADMIN_USER_IDS=
# Optional JSON overrides for config/default.json, e.g. {"chat":{"recent_turns":10}}
SPICA_CONFIG=

# Web Push (Phase 6). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
