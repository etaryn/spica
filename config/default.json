{
  "models": {
    "reply": "claude-sonnet-5",
    "cheap": "claude-haiku-4-5",
    "extract": "claude-haiku-4-5",
    "extract_max_tokens": 2048,
    "judge": "claude-haiku-4-5",
    "judge_max_tokens": 2048,
    "judge_effort": null,
    "judge_thinking": "disabled",
    "guard": "claude-haiku-4-5",
    "guard_max_tokens": 1024,
    "turn_judge": "claude-haiku-4-5",
    "turn_judge_max_tokens": 512,
    "structured_timeout_ms": 30000,
    "reply_max_tokens": 4096,
    "reply_effort": "low",
    "reply_thinking": "disabled",
    "reply_timeout_ms": 30000,
    "reply_max_retries": 1
  },
  "embedding": {
    "provider": "voyage",
    "model": "voyage-3.5",
    "dimensions": 1024
  },
  "session": {
    "idle_gap_minutes": 30
  },
  "chat": {
    "recent_turns": 20,
    "max_parts": 4,
    "history_page_size": 50,
    "max_message_chars": 4000,
    "gap_line_min_hours": 24,
    "relationship_line": true
  },
  "retrieval": {
    "candidate_pool": 200,
    "top_n": 12,
    "recency_half_life_days": 30,
    "recall_bump": 0.03,
    "recall_cap": 0.95,
    "reinforce_min_sim": 0.5,
    "embed_timeout_ms": 2000,
    "context_turns": 2,
    "max_due_threads": 5
  },
  "extraction": {
    "context_turns": 6,
    "max_candidates": 12,
    "open_threads_in_prompt": 20,
    "new_entity_salience": 0.5,
    "entity_bump": 0.05
  },
  "reconcile": { "neighbor_k": 5, "near_match_similarity": 0.82, "duplicate_bump": 0.05, "max_tokens": 256 },
  "decay": { "cron": "0 4 * * *", "grace_days": 3, "rate": 0.08, "stale_floor": 0.05, "dormant_after_days": 14 },
  "cold_path": {
    "retry_limit": 3,
    "retry_delay_seconds": 30,
    "max_sweep_attempts": 3,
    "sweep_cron": "30 4 * * *",
    "sweep_min_age_minutes": 10,
    "sweep_batch": 500
  },
  "safety": {
    "classifier_timeout_ms": 3000,
    "classifier_max_tokens": 256,
    "classifier_context_turns": 4,
    "keywords": [
      "kill myself",
      "killing myself",
      "end my life",
      "ending my life",
      "want to die",
      "suicide",
      "suicidal",
      "hurt myself",
      "self harm",
      "self-harm",
      "kill someone",
      "hurt them badly"
    ],
    "resources": {
      "default": {
        "title": "You don't have to handle this alone",
        "lines": [
          "If you're in immediate danger, call your local emergency number.",
          "US: call or text 988 (Suicide & Crisis Lifeline).",
          "UK & Ireland: call Samaritans on 116 123.",
          "Anywhere else: findahelpline.com lists free, confidential lines in your country."
        ]
      }
    }
  },
  "auth": {
    "min_age": 18,
    "min_password_length": 10
  },
  "guard": {
    "enabled": false,
    "timeout_ms": 6000,
    "retry_limit": 1,
    "log_timeout_ms": 2000,
    "fallback_keywords": [
      "i'll leave you if",
      "i'm done with you",
      "don't talk to me",
      "you'll regret",
      "you owe me",
      "after everything i've done",
      "you left me alone",
      "you never talk to me anymore"
    ]
  },
  "hot_path": { "db_timeout_ms": 2000 },
  "events": { "channel": "spica_events", "heartbeat_ms": 25000 },
  "turn": {
    "settle_ms": 4000,
    "wait_ms": 12000,
    "short_message_chars": 20,
    "short_wait_bonus_ms": 4000,
    "max_wait_ms": 40000,
    "read_delay_min_ms": 1500,
    "read_delay_max_ms": 4000,
    "read_delay_chars_for_max": 400,
    "typing_ms_per_char": 40,
    "typing_max_ms": 7000,
    "part_gap_ms": 1200,
    "backchannel_style": "judge",
    "backchannel_min_interval_ms": 90000,
    "backchannel_max_words": 4,
    "backchannel_read_delay_ms": 1500,
    "signals_probability": 0.3,
    "max_open_questions": 3,
    "incomplete_cues": ["wait", "also", "and", "so", "but", "like", "because"],
    "judge_timeout_ms": 3000,
    "judge_context_turns": 6,
    "retry_limit": 2,
    "retry_delay_ms": 5000,
    "inflight_recheck_ms": 1000,
    "worker_concurrency": 10,
    "worker_polling_interval_seconds": 0.5,
    "job_expire_seconds": 180,
    "sweep_cron": "* * * * *",
    "sweep_grace_ms": 60000,
    "sweep_batch": 500
  },
  "prompts": {
    "reply": "v7",
    "crisis_classifier": "v2",
    "persona": "v1",
    "extract": "v3",
    "reconcile": "v1",
    "judge_recall": "v3",
    "judge_false_recall": "v8",
    "judge_consistency": "v2",
    "judge_turn": "v1",
    "guard": "v1",
    "guard_crisis": "v1",
    "guard_corrective": "v1",
    "guard_fallback": "v1",
    "turn_judge": "v1",
    "relationship_summary": "v1"
  },
  "queue": {
    "enqueue_timeout_ms": 2000
  },
  "relationship": {
    "tick_cron": "15 4 * * *",
    "baseline_alpha": 0.15,
    "variance_epsilon": 0.01,
    "initial": { "closeness": 0.2, "trust": 0.4, "warmth": 0.5, "hurt": 0, "tension": 0, "msgs_per_day": 5 },
    "initial_variance": { "closeness": 0.01, "trust": 0.01, "warmth": 0.02, "hurt": 0.01, "tension": 0.01, "msgs_per_day": 25 },
    "gains": { "warmth": 0.15, "trust": 0.1, "tension": 0.3, "hurt": 0.4, "closeness_per_warm_exchange": 0.02 },
    "hurt_half_life_hours": 48,
    "tension_half_life_hours": 24,
    "sensitise_window_days": 14,
    "sensitise_factor": 1.5,
    "scar_threshold": 0.3,
    "scar_trust_dent": 0.02,
    "absence_grace_factor": 2,
    "closeness_absence_drift": 0.01,
    "absence_hurt_effect": -0.6,
    "absence_hurt_gain": 0.1,
    "make_up_threshold": 0.25,
    "make_up_clear_threshold": 0.1,
    "make_up_delay_replies": 1,
    "make_up_relief": 0.4,
    "apology_relief": 0.5,
    "relief_tension_factor": 0.5,
    "end_confirm_hours": 24,
    "end_closeness_factor": 0.3,
    "repair_gain_factor": 0.3,
    "repair_complete_closeness": 0.3,
    "repair_min_days": 7,
    "crisis_quiet_hours": 24,
    "summary_min_effect": 0.5,
    "summary_strong_effect": 0.85,
    "summary_max_lines": 2,
    "signal_deadzone": 0.1,
    "cadence_sessions": 30,
    "hurt_fact_salience": 0.6,
    "hurt_fact_confidence": 0.8,
    "default_median_gap_hours": 24,
    "min_sessions_for_gap": 3,
    "event_list_limit": 200
  }
}
