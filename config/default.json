{
  "models": {
    "reply": "claude-sonnet-5",
    "cheap": "claude-haiku-4-5",
    "reply_max_tokens": 4096,
    "reply_effort": "low",
    "reply_timeout_ms": 30000,
    "reply_max_retries": 1
  },
  "embedding": {
    "provider": "voyage",
    "model": "voyage-3.5",
    "dimensions": 1024
  },
  "session": {
    "idle_gap_minutes": 30
  },
  "chat": {
    "recent_turns": 20,
    "max_parts": 4,
    "history_page_size": 50,
    "max_message_chars": 4000
  },
  "safety": {
    "classifier_timeout_ms": 3000,
    "classifier_max_tokens": 256,
    "keywords": [
      "kill myself",
      "killing myself",
      "end my life",
      "ending my life",
      "want to die",
      "suicide",
      "suicidal",
      "hurt myself",
      "self harm",
      "self-harm",
      "kill someone",
      "hurt them badly"
    ],
    "resources": {
      "default": {
        "title": "You don't have to handle this alone",
        "lines": [
          "If you're in immediate danger, call your local emergency number.",
          "US: call or text 988 (Suicide & Crisis Lifeline).",
          "UK & Ireland: call Samaritans on 116 123.",
          "Anywhere else: findahelpline.com lists free, confidential lines in your country."
        ]
      }
    }
  },
  "auth": {
    "min_age": 18,
    "min_password_length": 10
  },
  "prompts": {
    "reply": "v1",
    "crisis_classifier": "v1"
  }
}
