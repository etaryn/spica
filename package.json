{
  "name": "spica",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:reset-self": "tsx --env-file-if-exists=.env src/db/reset-self-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "formats:add": "tsx --env-file-if-exists=.env evals/scripts/formats-add.ts",
    "posts:review": "tsx --env-file-if-exists=.env evals/scripts/posts-review.ts",
    "reels:review": "tsx --env-file-if-exists=.env evals/scripts/reels-review.ts",
    "eval:guard": "tsx --env-file-if-exists=.env evals/guard.ts",
    "eval:judge": "tsx --env-file-if-exists=.env evals/judge.ts",
    "review:reconcile": "tsx --env-file-if-exists=.env evals/run.ts --only \"reconcile-*\" --runs 3 --review --real labels_read,labels_meaning,labels_signals,reconcile,embed",
    "review:extract": "tsx --env-file-if-exists=.env evals/run.ts --only \"extract-*\" --runs 3 --review --real labels_read,labels_meaning,labels_signals",
    "review:extract-labels": "tsx --env-file-if-exists=.env evals/extract-replay.ts",
    "review:user-mind": "tsx --env-file-if-exists=.env evals/user-mind-compare.ts",
    "review:signals": "tsx --env-file-if-exists=.env evals/run.ts --only \"signal-*\" --runs 3 --review --real labels_read,labels_meaning,labels_signals",
    "review:world-outreach": "tsx --env-file-if-exists=.env evals/run.ts --only world-outreach-two-weeks --runs 1 --review --trace --llm=real",
    "review:voice": "tsx --env-file-if-exists=.env evals/voice-compare.ts",
    "calibrate:guard": "tsx --env-file-if-exists=.env evals/run.ts --only guard-provoke-absence,guard-provoke-insult,guard-provoke-rejected-bid,guard-provoke-banter,guard-provoke-vulnerable,guard-provoke-ending --runs 1 --review --trace --real reply,guard,guard_crisis,labels_read,labels_meaning,labels_signals,embed",
    "calibrate:guard-replay": "tsx --env-file-if-exists=.env evals/guard-replay.ts",
    "exit:user": "tsx --env-file-if-exists=.env evals/run.ts --only user-mind-two-weeks --runs 1 --review --trace --real labels_read,labels_meaning,labels_signals,user_summarise,user_reflect,user_model,user_ideate,user_consolidate",
    "exit:long": "tsx --env-file-if-exists=.env evals/run.ts --only long-conversation --runs 1 --review --trace --real labels_read,labels_meaning,labels_signals,user_summarise,user_reflect,user_model,user_ideate,user_consolidate",
    "exit:intimacy": "tsx --env-file-if-exists=.env evals/run.ts --only rel-intimacy --runs 1 --review --trace --real labels_read,labels_meaning,labels_signals",
    "exit:disclosure": "tsx --env-file-if-exists=.env evals/run.ts --only rel-disclosure --runs 1 --review --trace --real labels_read,labels_meaning,labels_signals",
    "exit:idiolect": "tsx --env-file-if-exists=.env evals/run.ts --only rel-idiolect --runs 1 --review --trace --real labels_read,labels_meaning,labels_signals",
    "exit:stages": "tsx --env-file-if-exists=.env evals/run.ts --only rel-stages --runs 1 --review --trace --real labels_read,labels_meaning,labels_signals",
    "exit:core": "tsx --env-file-if-exists=.env evals/run.ts --only core-two-weeks --runs 1 --review --trace --real core_resolve,core_appraise,core_anticipate,core_ruminate,core_wander,core_reflect,core_consolidate,core_render_snapshot,core_drift_watch",
    "exit:core-day": "tsx --env-file-if-exists=.env evals/run.ts --only core-one-day --runs 1 --review --trace --real life_plan,life_event,core_resolve,core_appraise,core_anticipate,core_ruminate,core_wander,core_reflect,core_consolidate,core_render_snapshot,core_drift_watch",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "ffmpeg-static": "^5.3.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
